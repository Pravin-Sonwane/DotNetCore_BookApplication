<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <img src="~/images/book4.jpg" asp-append-version=true height="30px" width="30px" />
                    Book Store
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-3 me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Book" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Book" asp-action="GetAllBooks">All Books</a>
                        </li>
                    </ul>

                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main class="main">
            @RenderBody()
    </main>
    <footer class="bg-dark text-light mt-5" role="contentinfo">
        <div class="container py-4">
            <div class="row gy-3">
                <div class="col-md-4 d-flex align-items-start">
                    <div>
                        <h5 class="mb-1">BookStore</h5>
                        <p class="mb-0 small">A small collection of carefully curated books. Find, read and enjoy.</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <h6 class="text-uppercase">Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a class="text-decoration-none text-light" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a class="text-decoration-none text-light" asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a class="text-decoration-none text-light" asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                        @* <li><a class="text-decoration-none text-light" asp-controller="Book" asp-action="Index">All Books</a></li> *@
                    </ul>
                </div>

                <div class="col-md-4">
                    <h6 class="text-uppercase">Contact</h6>
                    <address class="small">
                        123 Book St.<br />
                        Reading City, RC 12345<br />
                        <a href="mailto:info@bookstore.local" class="text-decoration-none text-light">info@bookstore.local</a>
                    </address>

                    <div class="mt-2">
                        <a href="#" class="text-light me-2" aria-label="Twitter">Twitter</a>
                        <a href="#" class="text-light me-2" aria-label="Facebook">Facebook</a>
                        <a href="#" class="text-light" aria-label="Instagram">Instagram</a>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <hr class="border-secondary" />
                    <p class="text-center small mb-0">&copy; @DateTime.Now.Year BookStore. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
