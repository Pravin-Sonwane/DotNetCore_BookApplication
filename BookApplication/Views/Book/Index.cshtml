@model IEnumerable<BookModel>

<section class="jumbotron text-center">
    <div class="container">
        <h1>WELCOME TO BOOK STORE</h1>
        <p class="lead text-muted">
            Welcome to Book Haven – your one-stop destination for knowledge, inspiration, and imagination.
            Discover a wide collection of books across various genres including Fiction, Non-Fiction, Technology, Self-Help, Academic, and Children’s literature.
        </p>
        <p>
            <a href="#" class="btn btn-primary my-2">Search Books</a>
        </p>
    </div>
</section>
<div class="py-5 bg-light">
    <div class="container">
        <div class="row">
            @foreach (var books in Model.Take(3))
            {
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        @* <svg class="bd-placeholder-img card-img-top" width="100%" height="225" xmlns="http://www.w3.org/2000"></svg> *@
                        <img src="~/images/Book3.jpg" asp-append-version=true class="card-img-top img-fluid" alt="Book Image" style="height:225px; object-fit:cover;" />
                        <div class="card-body">
                            <p class="card-text">@books.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-secondary">View Details</a>
                                </div>
                                <small class="text-muted">@books.Author</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>