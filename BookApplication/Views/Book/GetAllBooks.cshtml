@model IEnumerable<BookModel>

<div class="py-5 bg-light">
    <div class="container">
        <h3 class="h3">All Books</h3>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        @* <svg class="bd-placeholder-img card-img-top" width="100%" height="225" xmlns="http://www.w3.org/2000"></svg> *@
                        <img src="~/images/Book3.jpg" asp-append-version=true class="card-img-top img-fluid" alt="Book Image" style="height:225px; object-fit:cover;" />
                        <div class="card-body">
                            <p class="card-text">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="book" asp-action="Details" asp-route-id="@item.Id">View Details</a>
                                </div>
                                <small class="text-muted">@item.Author</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>